// ================= GEDUNG UTAMA BISA DIMASUKI: ruang kelas 30 bangku =================
const KELAS={desks:[],board:{x:0,z:-25.75},pod:{x:-16.4,z:-25.75}};
{for(let c=0;c<6;c++)for(let r=0;r<5;r++)KELAS.desks.push({x:-14+c*2.35,z:-28.7+r*1.5});}
const FL=1.25;// tinggi lantai dalam gedung (sama dengan teras atas monumen)
function gedung(){const tot=monTot(),bw=tot+6,hw=bw/2,z0=-30,z1=-21.5,H=11.6,cz=(z0+z1)/2,nt=ENV.night>.5,W='#f4f1ea',IN='#f6efe0';
 const win=(w,h)=>({tex:winTex(),win:1,uvs:[Math.max(1,Math.round(w/3.2)),Math.max(1,Math.round(h/3.2))]});
 // dinding luar (berjendela)
 D(BOX,W,[0,H/2,z0+.2],0,[bw,H,.4],win(bw,H));for(const s of[-1,1])D(BOX,W,[s*(hw-.2),H/2,cz],0,[.4,H,z1-z0],win(z1-z0,H));
 for(const s of[-1,1]){const w=hw-1.3;D(BOX,W,[s*(1.3+w/2),H/2,z1-.2],0,[w,H,.4],win(w,H))}D(BOX,W,[0,(5.3+H)/2,z1-.2],0,[2.6,H-5.3,.4]);
 D(BOX,'#dcd6ca',[0,H+.3,cz],0,[bw+.6,.6,z1-z0+.6]);D(BOX,'#e3342f',[0,H-.45,z1+.07],0,[bw,.4,.12],{cast:0});D(BOX,'#d9d2c4',[0,.25,cz],0,[bw+1,.5,z1-z0+1]);
 // bagian dalam: lantai, dinding dalam, plafon (tidak kena bayangan atap supaya terang)
 const R={recv:0,emis:nt?.08:.18};D(BOX,nt?'#cdbb98':'#e2cfa6',[0,FL-.05,cz],0,[bw-.8,.1,z1-z0-.8],{recv:0,cast:0});
 D(BOX,IN,[0,(FL+H)/2,z0+.43],0,[bw-.8,H-FL,.05],R);for(const s of[-1,1])D(BOX,IN,[s*(hw-.43),(FL+H)/2,cz],0,[.05,H-FL,z1-z0-.8],R);
 for(const s of[-1,1]){const w=hw-1.3-.4;D(BOX,IN,[s*(1.3+w/2),(FL+H)/2,z1-.43],0,[w,H-FL,.05],R)}D(BOX,IN,[0,(5.3+H)/2,z1-.43],0,[2.6,H-5.3,.05],R);
 D(BOX,'#fbf8f0',[0,H-.25,cz],0,[bw-.8,.1,z1-z0-.8],{recv:0,cast:0});
 for(const s of[-1,1])D(BOX,'#c9b48a',[0,FL+.08,cz+s*(z1-z0-.9)/2],0,[bw-.9,.16,.06],{recv:0,cast:0});
 // lampu plafon
 for(let i=0;i<6;i++){const lx=-15+i*6;for(const lz of[-27.6,-23.9])D(BOX,'#fffbe8',[lx,H-.33,lz],0,[2.2,.06,.5],{emis:1,cast:0,recv:0});if(i%2===0)LAMPS.push([lx+3,FL+8.5,-25.75])}
 // papan tulis + podium
 const bx=-hw+.47;D(BOX,'#9aa3ab',[bx,FL+2.35,KELAS.board.z],0,[.08,2.6,6],R);D(BOX,'#ffffff',[bx+.05,FL+2.35,KELAS.board.z],0,[.04,2.3,5.7],{recv:0,emis:nt?.15:0});
 D(BOX,'#9aa3ab',[bx+.16,FL+1.0,KELAS.board.z],0,[.22,.06,5.6],R);for(const [k,c] of [[-.6,'#e3342f'],[-.3,'#3a6ea5'],[0,'#2b1a0e']])D(BOX,c,[bx+.16,FL+1.05,KELAS.board.z+k],0,[.05,.05,.22],{cast:0,recv:0});
 const P=KELAS.pod;D(BOX,'#8a5a36',[P.x,FL+.6,P.z],0,[.8,1.2,1.1],R);D(BOX,'#a7764d',[P.x-.05,FL+1.24,P.z],[0,0,.18],[.95,.08,1.25],R);D(BOX,'#d8a93c',[P.x+.41,FL+.75,P.z],0,[.02,.3,.6],{cast:0,recv:0});
 // 30 bangku kuliah: meja + kursi menghadap papan tulis
 for(const d of KELAS.desks){D(BOX,'#c99b63',[d.x,FL+.78,d.z],0,[1.4,.07,.62],R);for(const s of[-1,1])D(BOX,'#6b4a2b',[d.x+s*.62,FL+.38,d.z],0,[.07,.76,.55],R);
  const cx=d.x+1.05;D(BOX,'#3a6ea5',[cx,FL+.47,d.z],0,[.5,.06,.5],R);D(BOX,'#3a6ea5',[cx+.24,FL+.8,d.z],0,[.05,.62,.5],R);D(BOX,'#3d3a44',[cx,FL+.22,d.z],0,[.06,.44,.06],R)}}
function gedungSolids(){const tot=monTot(),bw=tot+6,hw=bw/2,z0=-30,z1=-21.5,H=12;
 addBox(-hw,hw,z0,z0+.4,H);addBox(-hw,-hw+.4,z0,z1,H);addBox(hw-.4,hw,z0,z1,H);addBox(-hw,-1.3,z1-.4,z1,H);addBox(1.3,hw,z1-.4,z1,H);addBox(-1.3,1.3,z1-.4,z1,H,5.3);
 addBox(-tot/2-.2,-1.3,MON.z-.7,MON.z+.6,H);addBox(1.3,tot/2+.2,MON.z-.7,MON.z+.6,H);addBox(-1.3,1.3,MON.z-.7,MON.z+.6,H,5.3);
 // undakan masuk: anak tangga .4, teras .8, teras atas 1.25, lantai dalam 1.25
 addBox(-(tot+4)/2,(tot+4)/2,MON.z-3,MON.z+3,.8,0,1);addBox(-(tot+1.5)/2,(tot+1.5)/2,MON.z-2.2,MON.z+2.2,FL,0,1);addBox(-1.6,1.6,MON.z+3,MON.z+3.7,.4,0,1);
 addBox(-hw+.4,hw-.4,z0+.4,z1-.4,FL,0,1);
 for(const d of KELAS.desks)addBox(d.x-.7,d.x+.7,d.z-.32,d.z+.32,FL+.85,FL);
 addBox(KELAS.pod.x-.45,KELAS.pod.x+.45,KELAS.pod.z-.6,KELAS.pod.z+.6,FL+1.3,FL);addBox(-hw+.4,-hw+.75,KELAS.board.z-3,KELAS.board.z+3,FL+3.7,FL)}
// anak tangga di depan pintu
{const _mon=monument;monument=function(){_mon();const tot=monTot();D(BOX,'#dde2e6',[0,.2,MON.z+3.35],0,[3.2,.4,.7])}}

// ================= DUDUK OTOMATIS di bangku (kelas + kantin) =================
const SEAT={cur:null,skip:null,list:null};
function seatList(){if(SEAT.list)return SEAT.list;const L=[];
 for(const d of KELAS.desks)L.push({x:d.x+1.05,z:d.z,y:FL+.48,yaw:-Math.PI/2,ox:1,oz:0,gy:FL});
 // bangku kantin yang tidak ditempati NPC
 for(let i=0;i<4;i++){const tx=KX-5.4+i*3.6,tz=KZ+3.4;for(let k=0;k<3;k++)for(const b of [-1,1]){if(rnd(i*13+k*7+b)>=.45)continue;
  const p=KPT([tx+b*1.05,0,tz+(k-1)*1.1]),o=KPT([tx+b*1.9,0,tz+(k-1)*1.1]),ln=Math.hypot(o[0]-p[0],o[2]-p[2]);L.push({x:p[0],z:p[2],y:.58,yaw:(b>0?-Math.PI/2:Math.PI/2)+Math.PI/2,ox:(o[0]-p[0])/ln,oz:(o[2]-p[2])/ln,gy:0})}}
 return SEAT.list=L}
function seatInput(){let ix=JOY.x,iy=JOY.y;if(KEYS.KeyW||KEYS.ArrowUp)iy-=1;if(KEYS.KeyS||KEYS.ArrowDown)iy+=1;if(KEYS.KeyA||KEYS.ArrowLeft)ix-=1;if(KEYS.KeyD||KEYS.ArrowRight)ix+=1;return Math.hypot(ix,iy)>.08}
function seatStand(){const s=SEAT.cur;if(!s)return;SEAT.cur=null;PL1.sit=0;SEAT.skip=s;PL1.x=s.x+s.ox*.95;PL1.z=s.z+s.oz*.95;PL1.y=s.gy;PL1.vy=0;collide(PL1);if(typeof sendPos==='function')sendPos(true)}
{const _sp=stepPlayer;stepPlayer=function(dt){
 if(SEAT.cur){if(!seatInput()){const s=SEAT.cur;PL1.x=s.x;PL1.z=s.z;PL1.y=s.y;PL1.vy=0;PL1.yaw=s.yaw;PL1.moving=false;return}seatStand()}
 _sp(dt);
 if(SEAT.skip&&Math.hypot(PL1.x-SEAT.skip.x,PL1.z-SEAT.skip.z)>1.15)SEAT.skip=null;
 if(PL1.vy===0)for(const s of seatList()){if(s===SEAT.skip||Math.abs(PL1.y-s.gy)>.6)continue;if(Math.hypot(PL1.x-s.x,PL1.z-s.z)<.72){SEAT.cur=s;PL1.sit=1;PL1.x=s.x;PL1.z=s.z;PL1.y=s.y;PL1.yaw=s.yaw;PL1.moving=false;if(typeof sendPos==='function')sendPos(true);break}}}}
{const _j=jump;jump=function(){if(SEAT.cur){seatStand();return}_j()}}
