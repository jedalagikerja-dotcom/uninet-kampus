const FB_CFG={apiKey:"AIzaSyBq2b8RFiq0j47Hek0OghBABHv982ikuCw",authDomain:"uninet-kampus.firebaseapp.com",databaseURL:"https://uninet-kampus-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"uninet-kampus",storageBucket:"uninet-kampus.firebasestorage.app",messagingSenderId:"918457767424",appId:"1:918457767424:web:e42e5e58eed798ce296ae5"};
const FBV='10.14.1',FBU=n=>`https://www.gstatic.com/firebasejs/${FBV}/firebase-${n}.js`;
const NET={off:0,ig:null,auth:null,AU:null,on:false,uid:null,db:null,F:null,me:null,others:new Map(),last:{x:0,z:0,yaw:0,t:0},bubbles:new Map(),idleOff:false};
const BADW=["anjing","anjg","babi","kontol","kntl","memek","mmk","ngentot","ngewe","bangsat","bajingan","goblok","tolol","kampret","jancok","jancuk","pepek","lonte","pelacur","fuck","shit","bitch","porn","bokep","judi","slot","gacor","togel","casino","maxwin"];
function cleanText(s){let o=String(s||'').replace(/[\u0000-\u001f<>]/g,'').trim();for(const w of BADW){o=o.replace(new RegExp(w,'gi'),m=>m[0]+'*'.repeat(m.length-1))}return o}
function badName(s){const f=s.toLowerCase().replace(/[^a-z]/g,'');return BADW.some(w=>f.includes(w))}
function hashN(s){let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))|0;return Math.abs(h)}
function myName(){return NET.ig||('Tamu '+(NET.uid||'xxxx').slice(0,4).toUpperCase())}
function shown(n){return /^Tamu /.test(n)?n:'@'+n}
function igOk(v){return /^[a-z0-9._]{1,30}$/.test(v)&&!/^\.|\.$/.test(v)}
function igKey(v){return v.toLowerCase().replace(/\./g,',')}
const LS={get:k=>{try{return localStorage.getItem(k)||''}catch(e){return ''}},set:(k,v)=>{try{v?localStorage.setItem(k,v):localStorage.removeItem(k)}catch(e){}}};
const INAPP=/Instagram|FBAN|FBAV|Line\/|TikTok/i.test(navigator.userAgent);
// ---- UI ----
document.head.insertAdjacentHTML('beforeend',`<style>
#onl{cursor:pointer;font-family:var(--display);font-size:14px;border:3px solid var(--ink);border-radius:999px;padding:5px 11px;background:var(--cream);color:var(--ink);box-shadow:0 3px 0 var(--ink);display:flex;align-items:center;gap:6px;white-space:nowrap}
#onl i{width:9px;height:9px;border-radius:50%;background:#9aa1a8;display:inline-block}#onl.live i{background:#2fbf71}
#chatBtn{position:fixed;z-index:5;left:max(14px,env(safe-area-inset-left,0px));top:50%;transform:translateY(-50%);font-family:var(--display);font-size:14px;border:3px solid var(--ink);border-radius:16px;padding:10px 10px;background:var(--cream);color:var(--ink);box-shadow:0 3px 0 var(--ink);cursor:pointer}
#chatBtn b{display:block;font-size:11px;background:var(--red);color:#fff;border-radius:999px;padding:1px 6px;margin-top:4px}
#chat{position:fixed;z-index:6;left:max(12px,env(safe-area-inset-left,0px));top:calc(env(safe-area-inset-top,0px) + 110px);width:min(360px,calc(100% - 24px));max-height:min(46vh,380px);display:none;flex-direction:column;background:rgba(255,248,230,.96);border:3px solid var(--ink);border-radius:18px;box-shadow:0 5px 0 var(--ink);overflow:hidden}
#chat.open{display:flex}#chat header{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;font-family:var(--display);font-size:17px;border-bottom:2px solid #e2d6bf}
#chat header button{border:2px solid var(--ink);background:#fff;border-radius:10px;font:900 14px var(--body);width:30px;height:30px;cursor:pointer}
#chatLog{flex:1;overflow-y:auto;padding:8px 12px;font:600 14px/1.4 var(--body);color:#3b2a1c}
#chatLog p{margin:0 0 6px;word-wrap:break-word}#chatLog b{color:var(--ink)}#chatLog .me b{color:#3a6ea5}#chatLog .sys{color:#8a7560;font-style:italic}
#chatForm{display:flex;gap:6px;padding:8px;border-top:2px solid #e2d6bf}#chatIn{flex:1;min-width:0;border:2px solid var(--ink);border-radius:12px;padding:8px 10px;font:700 16px var(--body);background:#fff}
#chatForm .btn{padding:6px 12px}
#chatLog p.msg{cursor:pointer;border-radius:10px;padding:3px 6px;margin:0 -6px 4px}#chatLog p.msg:active{background:#f1e4c8}
#chatLog p.ment{background:#fff1b8;box-shadow:inset 3px 0 0 #f2b630}#chatLog .q{display:block;font-size:12px;color:#8a7560;border-left:3px solid #d8c7a5;padding-left:6px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#chatLog .at{color:#3a6ea5;font-weight:900}#chatLog b.rk{color:#b8860b}#chatLog b.rk i{font-style:normal;font-size:10px;background:#ffd23f;color:#2b1a0e;border:1.5px solid #2b1a0e;border-radius:6px;padding:0 4px;vertical-align:2px}#chatLog .at.mine{background:#ffd23f;color:#2b1a0e;border-radius:6px;padding:0 3px}
#replyBar{display:none;align-items:center;gap:8px;padding:6px 10px;background:#f6ecd6;border-top:2px solid #e2d6bf;font:700 13px var(--body);color:#5a4330}#replyBar.on{display:flex}#replyBar span{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#replyBar button{border:2px solid var(--ink);background:#fff;border-radius:8px;width:26px;height:26px;font:900 12px var(--body);cursor:pointer}
#mentList{display:none;flex-wrap:wrap;gap:6px;padding:6px 8px 0}#mentList.on{display:flex}#mentList button{font:800 13px var(--body);border:2px solid var(--ink);border-radius:999px;background:#fff;padding:4px 10px;cursor:pointer}
#toast{position:fixed;z-index:8;left:50%;top:calc(env(safe-area-inset-top,0px) + 70px);transform:translate(-50%,-20px);opacity:0;transition:all .3s;background:var(--ink);color:#fff;font:800 15px var(--body);padding:10px 16px;border-radius:999px;pointer-events:none;max-width:86vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#toast.on{opacity:1;transform:translate(-50%,0)}
#mode button.warn{background:var(--yellow)}
body:not(.walk) #chatBtn{display:none}
@media (max-width:620px){#chat{top:calc(env(safe-area-inset-top,0px) + 112px)}}
</style>`);
document.getElementById('mode').insertAdjacentHTML('afterbegin','<div id="onl" title="Mahasiswa online"><i></i><span>offline</span></div>');
document.getElementById('mode').insertAdjacentHTML('beforeend','<button id="mName">Nama</button>');
document.body.insertAdjacentHTML('beforeend',`<div id="toast" role="status"></div><button id="chatBtn" aria-label="Buka chat kampus">CHAT</button>
<div id="chat" role="dialog" aria-label="Chat kampus"><header>Chat Kampus<button id="chatX" aria-label="Tutup chat">✕</button></header><div id="chatLog" aria-live="polite"></div>
<div id="replyBar"><span></span><button type="button" id="replyX" aria-label="Batal membalas">✕</button></div><div id="mentList"></div><form id="chatForm" autocomplete="off"><input id="chatIn" maxlength="120" placeholder="Tulis pesan…" enterkeyhint="send"><button class="btn" type="submit">Kirim</button></form></div>`);
const chatEl=document.getElementById('chat'),chatLog=document.getElementById('chatLog'),chatIn=document.getElementById('chatIn'),chatBtn=document.getElementById('chatBtn');let unread=0;
function setUnread(n){unread=n;chatBtn.innerHTML='CHAT'+(n?`<b>${n>9?'9+':n}</b>`:'')}
function openChat(on){chatEl.classList.toggle('open',on);if(on){setUnread(0);chatLog.scrollTop=chatLog.scrollHeight;setTimeout(()=>chatIn.focus(),50)}}
chatBtn.onclick=()=>openChat(!chatEl.classList.contains('open'));document.getElementById('chatX').onclick=()=>openChat(false);
function logLine(name,msg,cls){const p=document.createElement('p');if(cls)p.className=cls;if(name){const b=document.createElement('b');b.textContent=name+': ';p.appendChild(b)}p.appendChild(document.createTextNode(msg));chatLog.appendChild(p);while(chatLog.children.length>60)chatLog.firstChild.remove();
 if(chatEl.classList.contains('open'))chatLog.scrollTop=chatLog.scrollHeight}
const MSG=new Map();let REPLY=null;
function esc(t){return t.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function fmtMsg(m){return esc(m).replace(/@([a-z0-9._]{1,30})/gi,(a,u)=>`<span class="at${NET.ig&&u.toLowerCase()===NET.ig?' mine':''}">@${u}</span>`)}
function msgLine(key,v){const p=document.createElement('p');p.className='msg'+(v.u===NET.uid?' me':'')+(v.ment?' ment':'');p.dataset.k=key;
 let q='';if(v.r){const o=MSG.get(v.r);q=`<span class="q">↪ ${o?esc(shown(o.n))+': '+esc(o.m.slice(0,60)):'membalas pesan sebelumnya'}</span>`}
 p.innerHTML=q+(SPECIAL[v.n]?`<b class="rk">${esc(shown(v.n))} <i>REKTOR</i>:</b> `:(LABELS[v.n]?`<b>${esc(shown(v.n))} <i style="font-style:normal;font-size:11px;background:${LABELS[v.n].c};color:#fff;border:2px solid #2b1a0e;border-radius:999px;padding:0 6px">${esc(LABELS[v.n].t)}</i>:</b> `:`<b>${esc(shown(v.n))}:</b> `))+fmtMsg(v.m);p.onclick=()=>setReply(key);chatLog.appendChild(p);while(chatLog.children.length>60)chatLog.firstChild.remove();
 if(chatEl.classList.contains('open'))chatLog.scrollTop=chatLog.scrollHeight}
function setReply(key){const o=key&&MSG.get(key);REPLY=o?key:null;const bar=document.getElementById('replyBar');bar.classList.toggle('on',!!o);
 if(o){bar.firstChild.textContent='Membalas '+shown(o.n)+': '+o.m.slice(0,50);if(!/^Tamu /.test(o.n)&&o.u!==NET.uid&&!chatIn.value.includes('@'+o.n))chatIn.value='@'+o.n+' '+chatIn.value;chatIn.focus()}}
let toastT=0;function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('on');clearTimeout(toastT);toastT=setTimeout(()=>e.classList.remove('on'),3500)}
function mentionCands(pre){const set=new Set();for(const o of NET.others.values())if(!/^Tamu /.test(o.n))set.add(o.n);for(const o of MSG.values())if(!/^Tamu /.test(o.n))set.add(o.n);if(NET.ig)set.delete(NET.ig);
 return [...set].filter(n=>n.startsWith(pre.toLowerCase())).slice(0,6)}
function updMent(){const L=document.getElementById('mentList'),mm=chatIn.value.slice(0,chatIn.selectionEnd||chatIn.value.length).match(/(^|\s)@([a-z0-9._]{0,30})$/i);
 if(!mm){L.classList.remove('on');return}const c=mentionCands(mm[2]);if(!c.length){L.classList.remove('on');return}
 L.innerHTML='';for(const n of c){const b=document.createElement('button');b.type='button';b.textContent='@'+n;b.onmousedown=b.ontouchstart=e=>e.preventDefault();
  b.onclick=()=>{const end=chatIn.selectionEnd||chatIn.value.length,before=chatIn.value.slice(0,end).replace(/@([a-z0-9._]{0,30})$/i,'@'+n+' ');chatIn.value=before+chatIn.value.slice(end);L.classList.remove('on');chatIn.focus()};L.appendChild(b)}L.classList.add('on')}
function showOnlineList(){const now=srvNow(),L=[...NET.others.values()].filter(o=>now-o.seen<70000).map(o=>({n:o.n,d:Math.hypot(o.x-PL1.x,o.z-PL1.z)})).sort((a,b)=>a.d-b.d);
 showCard(`<h2>${L.length+1} mahasiswa online</h2><p>${NET.ig?'<b>@'+esc(NET.ig)+'</b> (kamu)':'Kamu (Tamu)'}</p><div style="max-height:40vh;overflow-y:auto;touch-action:pan-y">${L.length?L.map(o=>`<p style="margin:0 0 6px">${esc(shown(o.n))} <span style="color:#8a7560;font-size:13px">· ${o.d<8?'di dekatmu':Math.round(o.d)+' m'}</span></p>`).join(''):'<p>Belum ada mahasiswa lain. Ajak temanmu ke kampus!</p>'}</div>`)}
function setOnl(n,live){const e=document.getElementById('onl');e.classList.toggle('live',!!live);e.lastChild.textContent=live?(n+' online'):'offline'}
// ---- identitas: username IG yang dikunci ----
function updName(){const b=document.getElementById('mName');b.textContent=NET.ig?shown(NET.ig):'Daftar / Masuk';b.classList.toggle('warn',!NET.ig);chatIn.placeholder=NET.ig?'Tulis pesan…':'Daftar atau masuk dulu untuk chat'}
const IGMAIL=v=>'ig_'+v.replace(/\./g,'-')+'@kampus.uninet.id';
function igFromUser(u){const e=u&&!u.isAnonymous&&u.email?u.email.toLowerCase():'';if(e==='jedalagikerja@gmail.com')return 'uninet.id';const m=e.match(/^ig_([a-z0-9_-]{1,30})@kampus\.uninet\.id$/);return m?m[1].replace(/-/g,'.'):null}
async function switchUser(u){await NET.F.set(NET.me,null).catch(()=>{});await useUser(u)}
async function authDo(mode,v,pw){const AU=NET.AU,auth=NET.auth,em=IGMAIL(v);
 try{const r=mode==='daftar'?await AU.createUserWithEmailAndPassword(auth,em,pw):await AU.signInWithEmailAndPassword(auth,em,pw);await switchUser(r.user);return 'ok'}
 catch(e){const c=e.code||'';return c==='auth/email-already-in-use'?'exists':/invalid-credential|user-not-found|wrong-password|invalid-login/.test(c)?'wrong':c==='auth/too-many-requests'?'slow':c==='auth/operation-not-allowed'?'off':c==='auth/network-request-failed'?'net':'error'}}
function openIdentity(reason,tab){const INP='display:flex;align-items:center;border:3px solid var(--ink);border-radius:12px;background:#fff;padding:0 10px;margin-top:8px';const IS='flex:1;min-width:0;border:0;padding:9px 4px;font:800 16px var(--body);background:transparent';
 if(NET.ig){showCard(`<h2>Namamu di kampus</h2><p>${reason||'Kamu masuk sebagai <b>@'+NET.ig+'</b>. Kamu bisa masuk dengan username dan password yang sama di HP, tablet, atau browser lain kapan saja, tanpa harus keluar dulu dari sini.'}</p><div class="row"><button class="btn dark" type="button" id="avOpen">Ubah karakter</button>${NET.ig==='uninet.id'?'<button class="btn" type="button" id="qrbSet" style="background:#ffd23f">Pasang papan traktir di sini</button>':''}<button class="btn" type="button" id="outBtn" style="background:#fff">Keluar</button><button class="btn dark" type="button" id="okBtn">Oke</button></div>`);
  document.getElementById('avOpen').onclick=()=>{closeCard();openAvatar()};document.getElementById('okBtn').onclick=closeCard;document.getElementById('outBtn').onclick=async()=>{try{await NET.F.set(NET.me,null).catch(()=>{});await NET.AU.signOut(NET.auth);const r=await NET.AU.signInAnonymously(NET.auth);await switchUser(r.user)}catch(e){}closeCard();updName()};return}
 const T=tab==='masuk'?'masuk':'daftar',D=T==='daftar';
 showCard(`<h2>${D?'Daftar jadi mahasiswa':'Masuk ke Kampus UNINET'}</h2><p>${reason||(D?'Pakai username Instagram kamu dan buat password. Setelah itu kamu bisa masuk dari HP atau browser mana pun.':'Masukkan username Instagram dan password yang kamu buat waktu daftar.')}</p>
 <div class="row" role="tablist"><button type="button" class="btn${D?' dark':''}" id="tD" role="tab" aria-selected="${D}" style="${D?'':'background:#fff'}">Daftar</button><button type="button" class="btn${D?'':' dark'}" id="tM" role="tab" aria-selected="${!D}" style="${D?'background:#fff':''}">Sudah punya akun? Masuk</button></div>
 <form id="nmF" autocomplete="on"><label style="${INP}"><b style="font:900 17px var(--body)">@</b><input id="nmI" name="username" autocomplete="username" maxlength="30" autocapitalize="none" autocorrect="off" spellcheck="false" style="${IS}" placeholder="username IG" aria-label="Username Instagram"></label>
 <label style="${INP}"><input id="nmP" name="password" type="password" autocomplete="${D?'new-password':'current-password'}" maxlength="40" style="${IS}" placeholder="${D?'buat password (min. 6 huruf)':'password'}" aria-label="Password"></label>
 ${D?`<label style="${INP}"><input id="nmP2" type="password" autocomplete="new-password" maxlength="40" style="${IS}" placeholder="ulangi password" aria-label="Ulangi password"></label>`:''}
 <div class="row" style="margin-top:10px"><button class="btn dark" type="submit">${D?'Daftar':'Masuk'}</button><button class="btn" id="skipBtn" type="button" style="background:#fff">Nanti saja</button></div></form>
 <p id="nmE" role="status" style="color:#b0302b;margin:8px 0 4px;min-height:1em"></p><p style="margin:0;font-size:14px">Lupa password? DM @uninet.id.</p>`);
 document.getElementById('tD').onclick=()=>openIdentity(null,'daftar');document.getElementById('tM').onclick=()=>openIdentity(null,'masuk');document.getElementById('skipBtn').onclick=()=>closeCard();
 const i=document.getElementById('nmI'),P=document.getElementById('nmP'),P2=document.getElementById('nmP2'),E=document.getElementById('nmE');
 const pre=[LS.get('uninet_ig'),(LS.get('uninet_nama')||'').toLowerCase()].find(x=>x&&igOk(x))||'';i.value=pre;
 document.getElementById('nmF').onsubmit=async e=>{e.preventDefault();const v=i.value.trim().replace(/^@+/,'').toLowerCase(),pw=P.value;E.style.color='#b0302b';
  if(!igOk(v)){E.textContent='Username Instagram hanya huruf kecil, angka, titik, dan garis bawah.';return}if(D&&badName(v)){E.textContent='Username ini tidak bisa dipakai.';return}
  if(pw.length<6){E.textContent='Password minimal 6 huruf.';return}if(D&&P2.value!==pw){E.textContent='Ulangi password belum sama.';return}
  if(!NET.on){E.textContent='Belum tersambung ke kampus. Coba lagi sebentar.';return}
  E.style.color='#4a3524';E.textContent=D?'Mendaftarkan…':'Masuk…';const r=await authDo(T,v,pw);
  if(r==='ok'){LS.set('uninet_ig',v);closeCard();updName();logLine('',(D?'Selamat datang, mahasiswa baru @':'Selamat datang kembali, @')+v+'!','sys');if(D||!NET.av)setTimeout(()=>openAvatar(true),400);return}
  E.style.color='#b0302b';E.textContent={exists:'@'+v+' sudah terdaftar. Ketuk "Sudah punya akun? Masuk".',wrong:'Username atau password salah.',slow:'Terlalu banyak percobaan. Tunggu sebentar lalu coba lagi.',off:'Pendaftaran belum diaktifkan admin.',net:'Koneksi bermasalah. Coba lagi.'}[r]||'Gagal. Coba lagi sebentar.'}}
async function useUser(u){const F=NET.F;NET.uid=u.uid;NET.sid=u.uid+'_'+Math.random().toString(36).slice(2,8);NET.me=F.ref(NET.db,'online/'+NET.sid);F.onDisconnect(NET.me).remove();NET.ig=igFromUser(u);NET.av=null;NET.avEdit=null;updName();if(NET.ig){try{const a=await F.get(F.ref(NET.db,'avatar/'+u.uid));NET.av=parseAv(a.val())}catch(e){}}sendPos(true)}
// ---- tekstur nama & gelembung ----
const LABELS={'ayaa':{t:'Kang Pukul',c:'#e3342f'}};
function lblTex(n){const L=LABELS[n];return ctex('lb_'+n,300,64,(x,w,h)=>{x.font=FD(34);const tw=Math.min(w-8,x.measureText(L.t).width+34);x.fillStyle=L.c;x.strokeStyle='#2b1a0e';x.lineWidth=5;x.beginPath();x.roundRect((w-tw)/2,5,tw,h-10,24);x.fill();x.stroke();x.fillStyle='#fff';x.textAlign='center';x.textBaseline='middle';x.fillText(L.t,w/2,h/2+2)})}
function nameTagTex(n){return ctex('nt_'+n,320,72,(x,w,h)=>{x.font=FD(38);const tw=Math.min(w-12,x.measureText(n).width+36);x.fillStyle='rgba(255,248,230,.95)';x.strokeStyle='#2b1a0e';x.lineWidth=5;x.beginPath();x.roundRect((w-tw)/2,6,tw,h-12,28);x.fill();x.stroke();x.fillStyle='#2b1a0e';x.textAlign='center';x.textBaseline='middle';let s=n;while(x.measureText(s).width>w-50&&s.length>3)s=s.slice(0,-1);x.fillText(s===n?n:s+'…',w/2,h/2+2)})}
function bubbleTex(key,msg){return ctex('bb_'+key,512,170,(x,w,h)=>{x.font='800 30px Nunito, sans-serif';const words=msg.split(' ');const lines=[];let cur='';for(const wd of words){const t=cur?cur+' '+wd:wd;if(x.measureText(t).width>w-60&&cur){lines.push(cur);cur=wd}else cur=t}if(cur)lines.push(cur);const L=lines.slice(0,3);if(lines.length>3)L[2]=L[2].slice(0,-1)+'…';
 const bh=24+L.length*36,bw=Math.min(w-8,Math.max(...L.map(l=>x.measureText(l).width))+44),y0=h-bh-22;x.fillStyle='#fff';x.strokeStyle='#2b1a0e';x.lineWidth=5;x.beginPath();x.roundRect((w-bw)/2,y0,bw,bh,22);x.fill();x.stroke();
 x.beginPath();x.moveTo(w/2-12,y0+bh-2);x.lineTo(w/2,h-4);x.lineTo(w/2+12,y0+bh-2);x.fill();x.stroke();x.fillStyle='#fff';x.fillRect(w/2-10,y0+bh-6,20,6);x.fillStyle='#2b1a0e';x.textAlign='center';x.textBaseline='top';L.forEach((l,i)=>x.fillText(l,w/2,y0+14+i*36))})}
function dropTex(key){if(TX[key]){gl.deleteTexture(TX[key]);delete TX[key]}}
// ---- gambar mahasiswa online lain ----
const SHIRT=['#ff8a5c','#6cc3f5','#ffd166','#8bd17c','#c79bf2','#ff9fb8','#5fd0c5','#f7a440','#e3342f','#2f8f6a'];
function srvNow(){return Date.now()+NET.off}
function drawOthers(dt){const now=srvNow();let k=Math.min(1,dt*6);for(const [id,o] of NET.others){if(now-o.seen>70000)continue;
  const dx=o.tx-o.x,dz=o.tz-o.z,d=Math.hypot(dx,dz);o.x+=dx*k;o.z+=dz*k;let dy=o.tyaw-o.yaw;while(dy>Math.PI)dy-=2*Math.PI;while(dy<-Math.PI)dy+=2*Math.PI;o.yaw+=dy*k;o.mv=d>.05;if(o.mv)o.ph=(o.ph||0)+dt*10;
  const h=o.mv?Math.abs(Math.sin(o.ph))*.1:0,far=(o.x-EYE[0])**2+(o.z-EYE[2])**2;
  if(SPECIAL[o.n]){rektor(o.x,o.z,o.yaw,(o.y||0)+h,o.mv?Math.sin(o.ph)*.9:0,o.y||0,o.s);if(far<3600)textPlane(specialTag(o.n),o.x,(o.y||0)+2.35,o.z,1.35,.42,cam.yaw,{emis:1,recv:0})}
  else{person(o.x,o.z,o.c,o.yaw,(o.y||0)+h,{sit:o.s,av:o.av,col:SHIRT[o.c%SHIRT.length],swing:o.mv?Math.sin(o.ph)*.9:0});if(far<1600){textPlane(nameTagTex(shown(o.n)),o.x,(o.y||0)+2.1,o.z,1.7,.38,cam.yaw,{emis:1,recv:0});if(LABELS[o.n])textPlane(lblTex(o.n),o.x,(o.y||0)+1.76,o.z,1.3,.28,cam.yaw,{emis:1,recv:0})}}
  const b=NET.bubbles.get(o.u);if(b&&now<b.until&&far<2500)textPlane(bubbleTex(b.key,b.m),o.x,(o.y||0)+2.95,o.z,2.5,.83,cam.yaw,{emis:1,recv:0})}
 const mb=NET.bubbles.get(NET.uid);if(WALK&&mb&&now<mb.until)textPlane(bubbleTex(mb.key,mb.m),PL1.x,PL1.y+2.95,PL1.z,2.5,.83,cam.yaw,{emis:1,recv:0});
 for(const [id,b] of NET.bubbles)if(now>b.until+500){dropTex('bb_'+b.key);NET.bubbles.delete(id)}}
// ---- kirim posisi ----
let lastInput=Date.now();['touchstart','keydown','mousedown'].forEach(ev=>addEventListener(ev,()=>{lastInput=Date.now();if(NET.idleOff&&NET.F){NET.idleOff=false;NET.F.goOnline(NET.db);setTimeout(()=>sendPos(true),300)}},{passive:true}));
function sendPos(force){if(!NET.on||!NET.uid||NET.idleOff)return;const now=Date.now(),L=NET.last,moved=Math.hypot(PL1.x-L.x,PL1.z-L.z)>.25||Math.abs(PL1.yaw-L.yaw)>.4;
 if(!force&&!(moved&&now-L.t>1200)&&now-L.t<25000)return;NET.last={x:PL1.x,z:PL1.z,yaw:PL1.yaw,t:now};
 const F=NET.F;const pd={u:NET.uid,n:myName(),x:+PL1.x.toFixed(2),z:+PL1.z.toFixed(2),y:+PL1.y.toFixed(2),yaw:+PL1.yaw.toFixed(2),c:hashN(NET.uid)%SHIRT.length,t:F.serverTimestamp()};if(NET.av)pd.a=avStr(NET.av);if(PL1.sit)pd.s=1;F.set(NET.me,pd).catch(e=>console.warn('pos',e&&e.code))}
function countOnline(){if(NET.idleOff)return;const now=srvNow();let n=1;for(const o of NET.others.values())if(now-o.seen<70000)n++;setOnl(n,true)}
// ---- sambung ke Firebase ----
async function netStart(){try{
  const [A,AU,D]=await Promise.all([import(FBU('app')),import(FBU('auth')),import(FBU('database'))]);
  const app=A.initializeApp(FB_CFG),auth=AU.getAuth(app),db=D.getDatabase(app);NET.db=db;NET.F=D;
  NET.auth=auth;NET.AU=AU;let user=await new Promise(r=>{const un=AU.onAuthStateChanged(auth,u=>{un();r(u)})});if(!user)user=(await AU.signInAnonymously(auth)).user;
  NET.on=true;await useUser(user);
  if(!NET.ig)setTimeout(()=>{if(card.hidden&&!NET.ig)openIdentity()},1200);
  const R=D.ref(db,'online');const up=s=>{if(s.key===NET.sid)return;const v=s.val()||{};if(typeof v.x!=='number')return;let o=NET.others.get(s.key);
   if(!o){o={x:v.x,z:v.z,yaw:v.yaw||0};NET.others.set(s.key,o)}Object.assign(o,{tx:v.x,tz:v.z,tyaw:v.yaw||0,y:v.y||0,n:cleanText(v.n||'Tamu').slice(0,30)||'Tamu',u:typeof v.u==='string'?v.u:s.key,av:parseAv(v.a),s:v.s===1,c:v.c||0,seen:typeof v.t==='number'?v.t:srvNow()});countOnline()};
  D.onChildAdded(R,up);D.onChildChanged(R,up);D.onChildRemoved(R,s=>{NET.others.delete(s.key);dropTex('nt_'+s.key);countOnline()});
  const Q=D.query(D.ref(db,'chat'),D.orderByChild('t'),D.limitToLast(30));let first=true;setTimeout(()=>first=false,2500);
  D.onChildAdded(Q,s=>{const v=s.val()||{};const m=cleanText(v.m).slice(0,120),n=cleanText(v.n).slice(0,30)||'Tamu';if(!m)return;
   const r=typeof v.r==='string'?v.r.slice(0,30):null,ro=r&&MSG.get(r);const ment=v.u!==NET.uid&&!!NET.ig&&(new RegExp('@'+NET.ig.replace(/\./g,'\\.')+'(?![a-z0-9._])','i').test(m)||(ro&&ro.u===NET.uid));
   MSG.set(s.key,{n,m,u:v.u});if(MSG.size>80)MSG.delete(MSG.keys().next().value);msgLine(s.key,{n,m,u:v.u,r,ment});
   if(ment&&!first&&Date.now()-(v.t||0)<20000){toast(shown(n)+(ro&&ro.u===NET.uid?' membalas pesanmu':' menyebut namamu')+': '+m.slice(0,40));try{navigator.vibrate&&navigator.vibrate(60)}catch(e){}}
   if(Date.now()-(v.t||0)<15000)NET.bubbles.set(v.u,{key:s.key,m,until:Date.now()+6000});if(!first&&!chatEl.classList.contains('open'))setUnread(unread+1)});
  logLine('',NET.ig?'Kamu masuk sebagai @'+NET.ig+'.':'Kamu masih Tamu. Ketuk "Daftar / Masuk" untuk memakai username IG.','sys');logLine('','Ketuk pesan untuk membalas. Ketik @ untuk menyebut nama.','sys');D.onValue(D.ref(db,'mading'),x=>{const v=x.val();if(v&&typeof v.judul==='string'&&typeof v.isi==='string'){CONFIG.pengumuman={judul:v.judul.slice(0,40),isi:v.isi.slice(0,200)};dropTex('board')}},()=>{});if(typeof brandStart==='function')brandStart();if(typeof qrbStart==='function')qrbStart();if(typeof kunjungStart==='function')kunjungStart();if(typeof ptStart==='function')ptStart();countOnline();
  document.addEventListener('visibilitychange',()=>{if(document.hidden){D.goOffline(db)}else{D.goOnline(db);setTimeout(()=>sendPos(true),400)}});
  D.onValue(D.ref(db,'.info/serverTimeOffset'),x=>{NET.off=x.val()||0;countOnline()});
  setInterval(()=>{if(NET.on&&!NET.idleOff&&Date.now()-lastInput>600000){NET.idleOff=true;D.goOffline(db);const e=document.getElementById('onl');e.classList.remove('live');e.lastChild.textContent='ketuk layar';}else countOnline()},5000);
 }catch(e){console.warn('online gagal',e);setOnl(0,false);logLine('','Mode online sedang tidak tersedia. Kamu tetap bisa jalan-jalan sendiri.','sys')}}
document.getElementById('chatForm').addEventListener('submit',async e=>{e.preventDefault();const m=cleanText(chatIn.value).slice(0,120);if(!m)return;if(NET.on&&!NET.ig){openIdentity('Isi username Instagram kamu dulu supaya bisa chat.');return}
 if(!NET.on){logLine('','Chat belum tersambung.','sys');return}const F=NET.F,key=F.push(F.ref(NET.db,'chat')).key;
 const msg={u:NET.uid,n:myName(),m,t:F.serverTimestamp()};if(REPLY)msg.r=REPLY;
 try{await F.update(F.ref(NET.db),{['chat/'+key]:msg,['rate/'+NET.uid]:F.serverTimestamp()});chatIn.value='';setReply(null);document.getElementById('mentList').classList.remove('on')}
 catch(err){logLine('','Pesan gagal terkirim. Tunggu 3 detik lalu coba lagi.','sys')}});
chatIn.addEventListener('keydown',e=>e.stopPropagation());chatIn.addEventListener('input',updMent);document.getElementById('replyX').onclick=()=>setReply(null);
document.getElementById('mName').onclick=()=>openIdentity();document.getElementById('onl').onclick=()=>{if(NET.on&&!NET.idleOff)showOnlineList()};
netStart();
// iPad/iPhone: cegah zoom halaman & kembalikan posisi setelah keyboard tertutup supaya UI tidak hilang
(function(){const vm=document.querySelector('meta[name=viewport]'),BASE='width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover';
 const unzoom=()=>{vm.setAttribute('content','width=device-width,initial-scale=1.0001,maximum-scale=1,user-scalable=no,viewport-fit=cover');setTimeout(()=>vm.setAttribute('content',BASE),50)};
 const reset=()=>{if(document.activeElement&&/INPUT|TEXTAREA/.test(document.activeElement.tagName))return;window.scrollTo(0,0);document.documentElement.scrollTop=0;document.body.scrollTop=0;
  if(window.visualViewport&&(visualViewport.scale>1.01||visualViewport.offsetTop>1||visualViewport.offsetLeft>1))unzoom()};
 document.addEventListener('focusout',()=>{setTimeout(reset,80);setTimeout(reset,400)});if(window.visualViewport){visualViewport.addEventListener('resize',()=>setTimeout(reset,80));visualViewport.addEventListener('scroll',()=>setTimeout(reset,80))}
 addEventListener('orientationchange',()=>setTimeout(reset,300));
 // blok pinch/double-tap zoom halaman (zoom 3D tetap lewat dua jari di area kampus)
 ['gesturestart','gesturechange','gestureend'].forEach(ev=>document.addEventListener(ev,e=>e.preventDefault(),{passive:false}));
 let lastTap=0;document.addEventListener('touchend',e=>{const t=Date.now();if(t-lastTap<300&&!/INPUT|TEXTAREA|BUTTON|A/.test(e.target.tagName))e.preventDefault();lastTap=t},{passive:false});
 document.head.insertAdjacentHTML('beforeend','<style>html,body{position:fixed;inset:0;width:100%;touch-action:none}input,textarea,select{font-size:max(16px,1em)}button{touch-action:manipulation}#chatLog{touch-action:pan-y}#mentList,#places{touch-action:pan-x}</style>');
 setInterval(reset,2000)})();

// ================= RUANG GANTI KARAKTER =================
const WARD={on:false,ty:1.5,prev:null};
(function(){const st=document.createElement('style');st.textContent=`#ward{position:fixed;z-index:8;right:max(10px,env(safe-area-inset-right,0px));top:64px;bottom:10px;width:min(360px,46vw);overflow-y:auto;overscroll-behavior:contain;background:var(--cream);border:3px solid var(--ink);border-radius:20px;box-shadow:0 5px 0 var(--ink);padding:14px 14px 10px;color:var(--ink);font-family:var(--body)}
#ward[hidden]{display:none}#ward h2{margin:0 0 4px;font-family:var(--display);font-size:22px}#ward .g{margin:10px 0 0}#ward .g b{display:block;font-size:14px;margin-bottom:6px}
#ward .opts{display:flex;flex-wrap:wrap;gap:7px}#ward .o{font:800 14px var(--body);border:2.5px solid var(--ink);border-radius:999px;padding:8px 12px;min-height:40px;background:#fff;color:var(--ink);cursor:pointer}
#ward .o[aria-pressed=true]{background:var(--ink);color:var(--cream)}#ward .sw{width:40px;height:40px;padding:0;border-radius:50%;border:3px solid var(--ink)}#ward .sw[aria-pressed=true]{outline:3px solid #ffd23f;outline-offset:2px}
#ward .act{position:sticky;bottom:-10px;background:var(--cream);display:flex;gap:8px;padding:10px 0 4px;margin-top:12px}
#avBtn{position:fixed;z-index:5;left:max(14px,env(safe-area-inset-left,0px));top:calc(50% - 98px);font-family:var(--display);font-size:12px;line-height:1.15;text-align:center;border:3px solid var(--ink);border-radius:16px;padding:8px 8px;background:var(--cream);color:var(--ink);box-shadow:0 3px 0 var(--ink);cursor:pointer}
body:not(.walk) #avBtn{display:none}body.ward #avBtn,body.ward #chatBtn,body.ward #umkmBtn{display:none}
@media (max-aspect-ratio:1/1){#ward{left:10px;right:10px;width:auto;top:auto;height:50vh}}`;document.head.appendChild(st);
 document.body.insertAdjacentHTML('beforeend','<button id="avBtn" type="button">UBAH<br>KARAKTER</button><div id="ward" role="dialog" aria-modal="false" aria-labelledby="wardT" hidden></div>');
 document.getElementById('avBtn').onclick=()=>openAvatar()})();
const AV_DEF={sh:0,sk:0,hs:0,hc:0,bd:1,tg:0,hat:0,hj:0};
function openAvatar(fresh){if(!NET.ig){openIdentity('Daftar atau masuk dulu supaya karaktermu tersimpan dan dilihat mahasiswa lain.');return}
 if(typeof SPECIAL!=='undefined'&&SPECIAL[NET.ig]){toast('Akun Rektor memakai karakter khusus.');return}
 if(typeof WALK!=='undefined'&&!WALK&&typeof setWalk==='function')setWalk(true);
 NET.avEdit=Object.assign({},NET.av||AV_DEF);WARD.on=true;WARD.prev={yaw:WCAM.yaw,pitch:WCAM.pitch,dist:WCAM.dist};document.body.classList.add('ward');
 WCAM.yaw=PL1.yaw;WCAM.pitch=.12;WCAM.dist=3.6;WARD.ty=matchMedia('(max-aspect-ratio:1/1)').matches?.35:1.15;closeCard();drawWard(fresh)}
function drawWard(fresh){const A=NET.avEdit,el=document.getElementById('ward');
 const sw=(k,cols,lab)=>`<div class="g"><b>${lab}</b><div class="opts">${cols.map((c,i)=>`<button type="button" class="o sw" data-k="${k}" data-v="${i}" aria-pressed="${A[k]===i}" aria-label="${lab} ${i+1}" style="background:${c}"></button>`).join('')}</div></div>`;
 const ch=(k,names,lab,off)=>`<div class="g"><b>${lab}</b><div class="opts">${names.map((n,i)=>`<button type="button" class="o" data-k="${k}" data-v="${i+(off||0)}" aria-pressed="${A[k]===i+(off||0)}">${n}</button>`).join('')}</div></div>`;
 const hjOn=A.hj>0;
 el.innerHTML=`<h2 id="wardT">${fresh?'Buat karaktermu':'Ubah karakter'}</h2><p style="margin:0;font-size:14px">Pilih tampilanmu. Mahasiswa lain langsung melihatnya di kampus.</p>
 ${sw('sk',AVC.sk,'Warna kulit')}${sw('sh',AVC.sh,'Warna baju')}${ch('bd',['Kurus','Sedang','Gemuk'],'Bentuk badan')}${ch('tg',['Normal','Tinggi','Pendek'],'Tinggi badan')}
 <div class="g"><b>Hijab</b><div class="opts"><button type="button" class="o" data-k="hj" data-v="0" aria-pressed="${A.hj===0}">Tidak</button>${AVC.hj.map((c,i)=>`<button type="button" class="o sw" data-k="hj" data-v="${i+1}" aria-pressed="${A.hj===i+1}" aria-label="Hijab warna ${i+1}" style="background:${c}"></button>`).join('')}</div></div>
 ${hjOn?'':ch('hs',['Pendek','Panjang','Keriting','Cepak','Botak'],'Rambut')+sw('hc',AVC.hc,'Warna rambut')+ch('hat',['Tanpa topi','Topi','Kupluk','Toga'],'Topi')}
 <div class="act"><button type="button" class="btn dark" id="wSave">Simpan</button><button type="button" class="btn" id="wCancel" style="background:#fff">Batal</button></div>`;
 el.hidden=false;el.querySelectorAll('[data-k]').forEach(b=>b.onclick=()=>{A[b.dataset.k]=+b.dataset.v;const st=el.scrollTop;drawWard(fresh);el.scrollTop=st});
 document.getElementById('wCancel').onclick=()=>closeWard();
 document.getElementById('wSave').onclick=async()=>{const b=document.getElementById('wSave');b.disabled=true;b.textContent='Menyimpan…';
  try{await NET.F.set(NET.F.ref(NET.db,'avatar/'+NET.uid),avStr(A));NET.av=Object.assign({},A);closeWard();sendPos(true);toast('Karaktermu tersimpan!')}
  catch(e){b.disabled=false;b.textContent='Simpan';toast('Gagal menyimpan. Coba lagi.')}}}
function closeWard(){NET.avEdit=null;WARD.on=false;document.getElementById('ward').hidden=true;document.body.classList.remove('ward');if(WARD.prev)Object.assign(WCAM,WARD.prev)}

// ================= MADING (hanya @uninet.id) =================
INFO.papan=()=>`<h2>${esc(CONFIG.pengumuman.judul)}</h2><p style="white-space:pre-line">${esc(CONFIG.pengumuman.isi)}</p><div class="row"><a class="btn" href="${CONFIG.igUrl}" target="_blank" rel="noopener">Buka @uninet.id</a>${NET.ig==='uninet.id'?'<button class="btn dark" type="button" id="madEdit">Ubah mading</button>':''}</div>`;
document.addEventListener('click',e=>{if(e.target&&e.target.id==='madEdit')openMading()});
function openMading(){if(NET.ig!=='uninet.id')return;const P=CONFIG.pengumuman,IS='width:100%;box-sizing:border-box;border:3px solid var(--ink);border-radius:12px;padding:9px 10px;font:800 16px var(--body);background:#fff;margin-top:6px';
 showCard(`<h2>Ubah mading</h2><p>Tulisan ini tampil di Papan Pengumuman untuk semua mahasiswa.</p><label style="font-weight:800;font-size:14px">Judul<input id="mdJ" maxlength="40" style="${IS}"></label><label style="display:block;margin-top:8px;font-weight:800;font-size:14px">Isi<textarea id="mdI" maxlength="200" rows="3" style="${IS};resize:vertical"></textarea></label><p id="mdE" role="status" style="margin:6px 0;min-height:1em;color:#b0302b"></p><div class="row"><button class="btn dark" type="button" id="mdS">Simpan</button><button class="btn" type="button" id="mdB" style="background:#fff">Batal</button></div>`);
 const J=document.getElementById('mdJ'),I=document.getElementById('mdI'),E=document.getElementById('mdE');J.value=P.judul;I.value=P.isi;
 document.getElementById('mdB').onclick=closeCard;
 document.getElementById('mdS').onclick=async()=>{const j=J.value.replace(/[<>]/g,'').trim(),i=I.value.replace(/[<>]/g,'').replace(/\r/g,'').replace(/[ \t]+/g,' ').replace(/\n{3,}/g,'\n\n').trim();if(!j||!i){E.textContent='Judul dan isi wajib diisi.';return}
  try{await NET.F.set(NET.F.ref(NET.db,'mading'),{judul:j,isi:i,t:NET.F.serverTimestamp()});closeCard();toast('Mading diperbarui!')}catch(err){E.textContent='Gagal menyimpan. Sudah tempel aturan database terbaru?'}}}
