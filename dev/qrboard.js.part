// ================= PAPAN QR "TRAKTIR PAK RAKA NGOPI" =================
const QRB={url:'https://saweria.co/UNINET',label:'saweria.co/UNINET',pos:null,M:null};
QRB.M=QRGEN.make(QRB.url);
function qrCanvas(px,margin){const M=QRB.M,n=M.length,c=document.createElement('canvas'),s=Math.floor(px/(n+margin*2));c.width=c.height=s*(n+margin*2);const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.fillStyle='#000';for(let r=0;r<n;r++)for(let k=0;k<n;k++)if(M[r][k])x.fillRect((k+margin)*s,(r+margin)*s,s,s);return c}
function qrbTex(){return ctex('qrb',640,900,(x,w,h)=>{x.fillStyle='#a7764d';x.fillRect(0,0,w,h);x.fillStyle='#fff8e6';x.strokeStyle='#2b1a0e';x.lineWidth=10;x.beginPath();x.roundRect(28,28,w-56,h-56,40);x.fill();x.stroke();
 x.strokeStyle='#2b1a0e';x.lineWidth=7;x.lineCap='round';x.lineJoin='round';x.beginPath();x.moveTo(268,92);x.lineTo(352,92);x.lineTo(352,124);x.arc(318,124,34,0,Math.PI);x.lineTo(268,92);x.stroke();x.beginPath();x.arc(362,112,12,-Math.PI/2,Math.PI/2);x.stroke();
 for(const k of[296,322]){x.beginPath();x.moveTo(k,58);x.quadraticCurveTo(k-8,68,k,78);x.stroke()}
 x.fillStyle='#2b1a0e';x.textAlign='center';x.textBaseline='middle';x.font=FD(64);x.fillText('TRAKTIR',w/2,215);x.fillText('PAK RAKA NGOPI',w/2,282);
 x.font='800 26px Nunito, sans-serif';x.fillStyle='#5c4430';x.fillText('Suka sama UNINET? Boleh traktir',w/2,340);x.fillText('kopi, seikhlasnya.',w/2,374);
 x.fillStyle='#fff';x.strokeStyle='#2b1a0e';x.lineWidth=8;x.beginPath();x.roundRect(150,410,340,340,24);x.fill();x.stroke();x.imageSmoothingEnabled=false;x.drawImage(qrCanvas(300,1),170,430,300,300);
 x.fillStyle='#2b1a0e';x.font='900 30px Nunito, sans-serif';x.fillText(QRB.label,w/2,800);x.font='700 22px Nunito, sans-serif';x.fillStyle='#7a5a3c';x.fillText('Ketuk papan untuk menyimpan QR',w/2,840)})}
function qrbDraw(){const P=QRB.pos;if(!P)return;const t=performance.now()/1000,y=(P.y||0)+2.6+Math.sin(t*1.4)*.12,yaw=(P.yaw||0)+Math.sin(t*.6)*.25,W=1.55,H=2.18;
 textPlane(qrbTex(),P.x,y,P.z,W,H,yaw,{emis:.85,recv:0});textPlane(qrbTex(),P.x,y,P.z,W,H,yaw+Math.PI,{emis:.85,recv:0});
 D(DISC,'#ffd77a',[P.x,(P.y||0)+.04,P.z],0,[1.6,.01,1.6],{alpha:.25+.1*Math.sin(t*2),emis:1,cast:0,recv:0});
 for(let i=0;i<4;i++){const a=t*1.2+i*1.57;D(ICO0,'#fff3a0',[P.x+Math.cos(a)*1.1,y-.6+Math.sin(t*2+i)*.4,P.z+Math.sin(a)*1.1],[t,t*2,0],[.06,.06,.06],{emis:1,cast:0})}}
{const _pk=proyek;proyek=function(){_pk();qrbDraw()}}
{const _np=nearPlace;nearPlace=function(){const P=QRB.pos;if(P&&Math.hypot(P.x-PL1.x,P.z-PL1.z)<2.6&&Math.abs((P.y||0)-PL1.y)<2){const b=document.getElementById('wNear');if(NEAR!=='qrb'){NEAR='qrb';b.textContent='Lihat: Traktir Pak Raka';b.hidden=false}return}_np()}}
{const wb=document.getElementById('wNear'),prev=wb.onclick;wb.onclick=e=>{if(NEAR==='qrb')openQRB();else if(prev)prev.call(wb,e)}}
function openQRB(){const img=qrCanvas(600,3).toDataURL('image/png');
 showCard(`<h2>Traktir Pak Raka Ngopi</h2><p>Suka sama UNINET? Boleh traktir kopi, seikhlasnya. Kampus tetap gratis untuk semua.</p>
 <img src="${img}" alt="Kode QR Saweria UNINET" style="display:block;width:min(240px,60vw);margin:6px auto;border:4px solid var(--ink);border-radius:14px;background:#fff">
 <p style="font-size:13px;margin:4px 0 8px;text-align:center">Dari HP ini: simpan gambar QR lalu pindai lewat galeri, atau langsung buka Saweria.</p>
 <div class="row"><a class="btn dark" href="${QRB.url}" target="_blank" rel="noopener">Buka Saweria</a><a class="btn" href="${img}" download="QR-Traktir-UNINET.png" style="background:#fff">Simpan gambar QR</a></div>`)}
document.addEventListener('click',async e=>{if(!e.target||e.target.id!=='qrbSet')return;if(NET.ig!=='uninet.id')return;
 try{await NET.F.set(NET.F.ref(NET.db,'qrboard'),{x:+PL1.x.toFixed(2),y:+PL1.y.toFixed(2),z:+PL1.z.toFixed(2),yaw:+(PL1.yaw+Math.PI).toFixed(3)});closeCard();toast('Papan traktir dipasang di sini!')}catch(err){toast('Gagal memasang. Sudah tempel aturan database terbaru?')}});
function qrbStart(){NET.F.onValue(NET.F.ref(NET.db,'qrboard'),s=>{const v=s.val();QRB.pos=v&&typeof v.x==='number'&&typeof v.z==='number'?v:null},()=>{})}
